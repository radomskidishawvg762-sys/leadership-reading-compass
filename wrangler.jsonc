{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadership-reading-compass",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-21",
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "18240621",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "MARKET_SNAPSHOTS",
        "class_name": "MarketSnapshots"
      }
    ]
  },
  "migrations": [
    {
      "tag": "market-snapshot-v1",
      "new_sqlite_classes": [
        "MarketSnapshots"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "10 * * * *"
    ]
  }
}
